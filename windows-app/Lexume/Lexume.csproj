<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Targets Windows 10+ (not Windows 7 - superseded decision, see git
    history/README.md), so this is modern .NET on a windows10-suffixed TFM,
    not .NET Framework. net10.0 is the current LTS. The windows10.0.19041.0
    target lets the project call WinRT APIs directly (Windows.Media.Ocr for
    the on-device OCR fallback in M4) while TargetPlatformMinVersion keeps
    the built app running on earlier Windows 10 feature updates, not just
    the exact SDK version it was compiled against.

    SDK-style project format (not the old per-file <Compile Include=.../>
    style) deliberately: it globs .cs/.xaml files under this folder
    automatically, so a new file added on disk is in the build without
    also hand-editing this file - the exact class of mistake that broke
    the iPad Xcode target earlier in this project (a file present on disk
    but never added to project.pbxproj). There's no compiler in this
    sandbox to catch that kind of drift here either.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>Lexume</RootNamespace>
    <AssemblyName>Lexume</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>

</Project>
