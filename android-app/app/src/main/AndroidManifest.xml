<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Gemini/ElevenLabs/Google Translate/dictionary API calls, and the
         optional Google Drive backup (M9) - all direct-to-provider, no app
         backend server involved (see plan's "BYO keys" decision). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- allowBackup is deliberately false, not the default omission:
         Android's Auto Backup would include the DataStore file holding the
         Keystore-encrypted Gemini/ElevenLabs keys (M3), but the Keystore key
         itself never leaves the device - restoring that file to a new/reset
         device leaves an undecryptable blob instead of a working key, a
         well-known Auto Backup + Keystore pitfall. -->
    <application
        android:name=".LexumeApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lexume">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Lexume">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
